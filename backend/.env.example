# ==========================================
# PHONG THỦY BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port & Mode
PORT=3001
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/phongthuy

# Redis Connection (RAM L1 + Redis L2 Cache & Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Token
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Google OAuth2 Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# AI Integration (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Email Configuration (Nodemailer for OTP & Notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Client CORS Configuration (Comma-separated origins)
CLIENT_URL=http://localhost:5173,http://localhost:5174
