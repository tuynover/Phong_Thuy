{
  "openapi": "3.0.0",
  "info": {
    "title": "Phong Thủy & Gieo Quẻ API",
    "version": "1.0.0",
    "description": "Tài liệu API và môi trường thử nghiệm trực quan cho Hệ thống Phong Thủy & Gieo Quẻ. Hỗ trợ đầy đủ các phân hệ Kinh Dịch, Bát Tự, Tử Vi, Kết Hôn, Trạch Cát và Quản Trị."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Máy chủ Phát triển (Local)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Nhập JWT token dạng: `Authorization: Bearer <token>`"
      },
      "queryAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "token",
        "description": "JWT token truyền trực tiếp dưới dạng tham số truy vấn: `?token=<token>` (sử dụng cho luồng Server-Sent Events - SSE)"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["email", "password", "name", "gender"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SecretPassword123"
          },
          "name": {
            "type": "string",
            "example": "Nguyen Van A"
          },
          "gender": {
            "type": "integer",
            "enum": [0, 1],
            "description": "1: Nam, 0: Nữ",
            "example": 1
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SecretPassword123"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": {
            "type": "string",
            "example": "OldPassword123"
          },
          "newPassword": {
            "type": "string",
            "example": "NewPassword888"
          }
        }
      },
      "IChingCalculateRequest": {
        "type": "object",
        "required": ["question", "userId"],
        "properties": {
          "question": {
            "type": "string",
            "example": "Sự nghiệp năm nay thế nào?"
          },
          "userId": {
            "type": "string",
            "description": "UUIDv7 của user hoặc 'guest'",
            "example": "guest"
          },
          "method": {
            "type": "string",
            "enum": ["luc_hao", "mai_hoa_time", "mai_hoa_money"],
            "description": "Phương pháp lập quẻ",
            "example": "luc_hao"
          },
          "tosses": {
            "type": "array",
            "items": {
              "type": "integer",
              "enum": [0, 1, 2, 3]
            },
            "description": "6 lần gieo đồng xu (1: 1 Ngửa, 2: 2 Ngửa, 3: 3 Ngửa, 0: 0 Ngửa) - Chỉ dùng cho phương pháp 'luc_hao'",
            "example": [3, 2, 2, 3, 1, 2]
          },
          "dateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Thời gian động tâm dạng ISO - Chỉ dùng cho phương pháp 'mai_hoa_time'",
            "example": "2026-07-02T15:00:00"
          },
          "serialNumber": {
            "type": "string",
            "description": "Seri tiền 8 số - Chỉ dùng cho phương pháp 'mai_hoa_money'",
            "example": "83749281"
          }
        }
      },
      "BaziAnalyzeRequest": {
        "type": "object",
        "required": ["date", "time", "gender", "userId"],
        "properties": {
          "date": {
            "type": "string",
            "description": "Ngày sinh dương lịch (YYYY-MM-DD)",
            "example": "2004-09-05"
          },
          "time": {
            "type": "string",
            "description": "Giờ sinh (HH:mm)",
            "example": "14:30"
          },
          "gender": {
            "type": "integer",
            "enum": [0, 1],
            "description": "1: Nam, 0: Nữ",
            "example": 1
          },
          "userId": {
            "type": "string",
            "description": "UUIDv7 của user hoặc 'guest'",
            "example": "guest"
          }
        }
      },
      "MarriageAnalyzeRequest": {
        "type": "object",
        "required": ["male", "female", "userId"],
        "properties": {
          "male": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "example": "2004-08-27" },
              "time": { "type": "string", "example": "07:30" }
            }
          },
          "female": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "example": "2001-01-02" },
              "time": { "type": "string", "example": "03:02" }
            }
          },
          "userId": {
            "type": "string",
            "example": "guest"
          }
        }
      },
      "ZiweiChartRequest": {
        "type": "object",
        "required": ["date", "hour", "gender", "calendarType"],
        "properties": {
          "date": {
            "type": "string",
            "description": "Ngày sinh (YYYY-MM-DD)",
            "example": "2004-09-05"
          },
          "hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11,
            "description": "Chỉ số giờ địa chi: 0 (Tý) đến 11 (Hợi)",
            "example": 7
          },
          "gender": {
            "type": "string",
            "enum": ["Nam", "Nữ"],
            "example": "Nam"
          },
          "calendarType": {
            "type": "string",
            "enum": ["solar", "lunar"],
            "example": "solar"
          }
        }
      },
      "AIChatRequest": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "example": "Hào động thứ 3 có ý nghĩa gì đặc biệt đối với công việc không?"
          }
        }
      },
      "RateRecordRequest": {
        "type": "object",
        "required": ["rating"],
        "properties": {
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "example": 5
          },
          "feedback": {
            "type": "string",
            "example": "Luận giải rất hay và chi tiết, ứng nghiệm."
          }
        }
      },
      "LinkRecordRequest": {
        "type": "object",
        "required": ["userId"],
        "properties": {
          "userId": {
            "type": "string",
            "description": "UUIDv7 của user mới",
            "example": "uuid-v7-new-user-id"
          }
        }
      },
      "DateCheckRequest": {
        "type": "object",
        "required": ["birthYear", "solarDate", "activity"],
        "properties": {
          "birthYear": {
            "type": "integer",
            "example": 1990
          },
          "solarDate": {
            "type": "string",
            "description": "Ngày cần kiểm tra (YYYY-MM-DD hoặc DD/MM/YYYY)",
            "example": "2026-07-03"
          },
          "solarHour": {
            "type": "string",
            "description": "Giờ kiểm tra (HH:mm) - Tùy chọn",
            "example": "12:00"
          },
          "activity": {
            "type": "string",
            "enum": ["dai_su", "khoi_nghiep", "xay_dung"],
            "description": "Công việc dự định làm",
            "example": "dai_su"
          }
        }
      },
      "DateConsultRequest": {
        "type": "object",
        "required": ["birthYear", "startDate", "endDate", "activity"],
        "properties": {
          "birthYear": {
            "type": "integer",
            "example": 1990
          },
          "startDate": {
            "type": "string",
            "example": "2026-07-01"
          },
          "endDate": {
            "type": "string",
            "example": "2026-07-07"
          },
          "activity": {
            "type": "string",
            "enum": ["dai_su", "khoi_nghiep", "xay_dung"],
            "example": "dai_su"
          }
        }
      },
      "AdminUpdateRoleRequest": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["user", "vip", "co-admin", "admin"],
            "example": "vip"
          }
        }
      },
      "AdminUpdateCreditsRequest": {
        "type": "object",
        "required": ["credits"],
        "properties": {
          "credits": {
            "type": "integer",
            "description": "Số lượng credits muốn cộng/trừ (chấp nhận số âm)",
            "example": 10
          }
        }
      },
      "AdminLockRequest": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "reason": {
            "type": "string",
            "example": "Spam AI quá nhiều lần"
          }
        }
      },
      "AdminResolveAppealRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["approved", "rejected"],
            "example": "approved"
          },
          "adminNotes": {
            "type": "string",
            "example": "Chấp thuận mở khóa tài khoản sau khi xem xét khiếu nại"
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Xác thực & Người dùng"],
        "summary": "Đăng ký tài khoản mới",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tạo tài khoản thành công",
            "content": {
              "application/json": {
                "example": {
                  "token": "eyJhbGciOi...",
                  "user": {
                    "id": "01908ef9-ef8a-7221-bf92-123456789abc",
                    "email": "user@example.com",
                    "name": "Nguyen Van A",
                    "credits": 1
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu gửi lên không hợp lệ hoặc email đã tồn tại"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Xác thực & Người dùng"],
        "summary": "Đăng nhập",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công",
            "content": {
              "application/json": {
                "example": {
                  "token": "eyJhbGciOi...",
                  "user": {
                    "id": "01908ef9-ef8a-7221-bf92-123456789abc",
                    "email": "user@example.com",
                    "name": "Nguyen Van A",
                    "credits": 1
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sai email hoặc mật khẩu"
          }
        }
      }
    },
    "/api/auth/change-password": {
      "put": {
        "security": [
          { "bearerAuth": [] }
        ],
        "tags": ["Xác thực & Người dùng"],
        "summary": "Thay đổi mật khẩu tài khoản hiện tại",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Thay đổi mật khẩu thành công",
            "content": {
              "application/json": {
                "example": {
                  "message": "Đổi mật khẩu thành công."
                }
              }
            }
          },
          "401": {
            "description": "Không có token hoặc token không hợp lệ"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "security": [
          { "bearerAuth": [] }
        ],
        "tags": ["Xác thực & Người dùng"],
        "summary": "Đăng xuất tài khoản",
        "description": "Đăng xuất và hủy bỏ hiệu lực của toàn bộ JWT token hiện tại trên máy chủ.",
        "responses": {
          "200": {
            "description": "Đăng xuất thành công",
            "content": {
              "application/json": {
                "example": {
                  "message": "Đăng xuất thành công."
                }
              }
            }
          },
          "401": {
            "description": "Không có token hoặc token không hợp lệ"
          }
        }
      }
    },
    "/api/auth/events": {
      "get": {
        "security": [
          { "queryAuth": [] }
        ],
        "tags": ["Xác thực & Người dùng"],
        "summary": "Đồng bộ tài khoản phía client qua SSE (Server-Sent Events)",
        "description": "Sự kiện được gửi đi: `account_locked`, `account_deleted`, `account_updated`",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "JWT Token"
          }
        ],
        "responses": {
          "200": {
            "description": "Luồng sự kiện được thiết lập thành công",
            "content": {
              "text/event-stream": {}
            }
          }
        }
      }
    },
    "/api/iching/calculate": {
      "post": {
        "tags": ["Tính toán & Gieo Quẻ"],
        "summary": "Tính toán Quẻ Kinh Dịch (Lập Quẻ)",
        "description": "Hỗ trợ 3 phương pháp gieo quẻ: Lục hào (tosses), Mai Hoa Dịch Số theo Giờ động tâm (mai_hoa_time) và Seri tiền 8 số (mai_hoa_money).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IChingCalculateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Thành công. Trả về đồ hình quẻ, hào động, nạp giáp, ngũ hành.",
            "content": {
              "application/json": {
                "example": {
                  "_id": "01908ef9-ef8a-7221-bf92-123456789abc",
                  "question": "Sự nghiệp năm nay thế nào?",
                  "primaryHexagram": { "name": "Thuần Càn", "number": 1 },
                  "transformedHexagram": { "name": "Thiên Phong Cấu", "number": 44 },
                  "movingLines": [1],
                  "lunarDateInfo": {
                    "dayCanChi": "Giáp Tý",
                    "monthCanChi": "Mậu Thìn"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bazi/analyze": {
      "post": {
        "tags": ["Tính toán & Gieo Quẻ"],
        "summary": "Lập Bản Đồ Tứ Trụ Bát Tự",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BaziAnalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Thành công. Trả về 4 trụ (Can Chi), Thập thần, Đại vận, Tiểu vận.",
            "content": {
              "application/json": {
                "example": {
                  "_id": "01908ef9-ef8a-7221-bf92-123456789def",
                  "inputInfo": {
                    "date": "2004-09-05",
                    "time": "14:30",
                    "gender": 1
                  },
                  "baziData": {
                    "year": { "gan": "Giáp", "zhi": "Thân" },
                    "month": { "gan": "Nhâm", "zhi": "Thân" },
                    "day": { "gan": "Quý", "zhi": "Hợi" },
                    "hour": { "gan": "Kỷ", "zhi": "Mùi" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/marriage/analyze": {
      "post": {
        "tags": ["Tính toán & Gieo Quẻ"],
        "summary": "Xem Tuổi Kết Hôn (Hợp Hôn)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarriageAnalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lập dữ liệu so sánh tuổi nam nữ thành công.",
            "content": {
              "application/json": {
                "example": {
                  "_id": "01908ef9-ef8a-7221-bf92-123456789ghi",
                  "maleBaziData": {},
                  "femaleBaziData": {},
                  "compatibilityScore": 8.5
                }
              }
            }
          }
        }
      }
    },
    "/api/ziwei": {
      "post": {
        "tags": ["Tính toán & Gieo Quẻ"],
        "summary": "Lập Mệnh Bàn Tử Vi",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ZiweiChartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Thành công. Trả về thông tin an sao 12 cung chi tiết dựa trên thư viện iztro.",
            "content": {
              "application/json": {
                "example": {
                  "_id": "01908ef9-ef8a-7221-bf92-123456789jkl",
                  "inputInfo": {
                    "date": "2004-09-05",
                    "hour": 7,
                    "gender": "Nam"
                  },
                  "chartData": {
                    "palaces": []
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/concept/{term}": {
      "get": {
        "tags": ["Tính toán & Gieo Quẻ"],
        "summary": "Tra cứu khái niệm học thuật phương Đông",
        "parameters": [
          {
            "name": "term",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Tên khái niệm học thuật (ví dụ: Phụ Mẫu, Thê Tài, Thanh Long...)",
            "example": "Phụ Mẫu"
          }
        ],
        "responses": {
          "200": {
            "description": "Khái niệm được tìm thấy",
            "content": {
              "application/json": {
                "example": {
                  "term": "Phụ Mẫu",
                  "category": "Lục Thân",
                  "short_description": "Cha mẹ, bề trên, giấy tờ, xe cộ, nhà cửa.",
                  "full_detail": "▸ Người đại diện: Cha mẹ, ông bà...\n▸ Sự vật: Hợp đồng, văn bằng..."
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy khái niệm"
          }
        }
      }
    },
    "/api/ai/{system}/{id}/interpret": {
      "post": {
        "security": [
          { "bearerAuth": [] }
        ],
        "tags": ["Luận Giải & Chat AI"],
        "summary": "Yêu cầu AI Luận giải (SSE Stream)",
        "description": "Bắt đầu stream SSE trả về các phân tích phong thủy từ Gemini. Cần truyền token JWT trong Authorization header.",
        "parameters": [
          {
            "name": "system",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["iching", "bazi", "ziwei", "marriage"]
            },
            "description": "Phân hệ tương ứng"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "UUIDv7 của bản ghi cần luận giải",
            "example": "01908ef9-ef8a-7221-bf92-123456789abc"
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công. Phát stream `text/event-stream` chứa các chuỗi markdown thô và kết thúc bằng sự kiện `done`.",
            "content": {
              "text/event-stream": {}
            }
          }
        }
      }
    },
    "/api/ai/{system}/{id}/chat": {
      "post": {
        "security": [
          { "bearerAuth": [] }
        ],
        "tags": ["Luận Giải & Chat AI"],
        "summary": "Chat hỏi đáp sâu về bản ghi (SSE Stream)",
        "description": "Gửi câu hỏi tiếp theo dựa trên bản cảnh quẻ/lá số đã lập để nhận câu trả lời dạng stream.",
        "parameters": [
          {
            "name": "system",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["iching", "bazi", "ziwei", "marriage"]
            },
            "description": "Phân hệ tương ứng"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "UUIDv7 của bản ghi",
            "example": "01908ef9-ef8a-7221-bf92-123456789abc"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AIChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Phát stream câu trả lời kèm event `structured` chứa các trường tóm tắt cuối cùng.",
            "content": {
              "text/event-stream": {}
            }
