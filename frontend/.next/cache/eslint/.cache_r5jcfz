 state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  35 |   useEffect(() => {\n  36 |     if (user) {\n> 37 |       setName(user.name || '');\n     |       ^^^^^^^ Avoid calling setState() directly within an effect\n  38 |       setPhone(user.phone || '');\n  39 |       setGender(user.gender !== undefined ? user.gender : 1);\n  40 |       setDay(user.baziInfo?.day || '');",["449"],"'event' is defined but never used.",["450"],"'triggerToast' is assigned a value but never used. Allowed unused vars must match /^[A-Z_]/u.",["451"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  87 |       const params = new URLSearchParams(window.location.search);\n  88 |       if (params.get('auth') === 'login' && !user) {\n> 89 |         setIsAuthModalOpen(true);\n     |         ^^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  90 |         const newUrl = window.location.pathname;\n  91 |         window.history.replaceState({}, '', newUrl);\n  92 |       }","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  225 |   // Clear history cache when user logs out or switches accounts\n  226 |   useEffect(() => {\n> 227 |     setPreloadedHistory(null);\n      |     ^^^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  228 |   }, [user?.id, user?._id]);\n  229 |\n  230 |   const handleDivinationComplete = async (lines, customDate, questionSuffix = '') => {","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  32 |\n  33 |   useEffect(() => {\n> 34 |     setSearch(value || '');\n     |     ^^^^^^^^^ Avoid calling setState() directly within an effect\n  35 |   }, [value]);\n  36 |\n  37 |   useEffect(() => {","React Hook useEffect has missing dependencies: 'activeUser?.name', 'handleZiweiComplete', and 'onClearAutoSubmit'. Either include them or remove the dependency array. If 'onClearAutoSubmit' changes too often, find the parent component that defines it and wrap that definition in useCallback.",["452"],"React Hook useEffect has a missing dependency: 'handleTriggerInterpretation'. Either include it or remove the dependency array.",["453"],"no-dupe-keys","Duplicate key 'Bát Tọa'.","ObjectExpression","unexpected","Duplicate key 'Thiên Quý'.","Fast refresh only works when a file only exports components. Move your React context(s) to a separate file.","reactContext","Duplicate key 'Thất Sát'.","Duplicate key 'Thiên Tài'.","Duplicate key 'Thanh Long'.","Duplicate key 'Bạch Hổ'.","Duplicate key 'Phúc Đức'.","Duplicate key 'Huynh Đệ'.","Duplicate key 'Thân'.","Duplicate key 'Thiên Đức'.","Duplicate key 'Nguyệt Đức'.","Duplicate key 'Văn Xương'.","Duplicate key 'Tướng Tinh'.","Duplicate key 'Kình Dương'.","Duplicate key 'Kiếp Sát'.","Duplicate key 'Vong Thần'.","Duplicate key 'Cô Thần'.","Duplicate key 'Quả Tú'.","Duplicate key 'Hoa Cái'.","Duplicate key 'Đào Hoa'.","Duplicate key 'Quốc Ấn'.","Duplicate key 'Thiên Y'.","Duplicate key 'Hồng Loan'.","Duplicate key 'Thiên Hỷ'.",{"messageId":"454","data":"455","fix":"456","desc":"457"},{"messageId":"454","data":"458","fix":"459","desc":"460"},{"messageId":"454","data":"461","fix":"462","desc":"463"},{"desc":"464","fix":"465"},{"desc":"466","fix":"467"},{"desc":"468","fix":"469"},{"desc":"470","fix":"471"},{"messageId":"454","data":"472","fix":"473","desc":"474"},{"messageId":"454","data":"475","fix":"476","desc":"477"},{"desc":"478","fix":"479"},{"desc":"480","fix":"481"},{"desc":"482","fix":"483"},{"messageId":"454","data":"484","fix":"485","desc":"486"},{"messageId":"454","data":"487","fix":"488","desc":"489"},{"messageId":"454","data":"490","fix":"491","desc":"492"},{"messageId":"454","data":"493","fix":"494","desc":"495"},{"messageId":"454","data":"496","fix":"497","desc":"498"},{"messageId":"454","data":"499","fix":"500","desc":"501"},{"desc":"502","fix":"503"},{"messageId":"454","data":"504","fix":"505","desc":"506"},{"desc":"507","fix":"508"},{"messageId":"45